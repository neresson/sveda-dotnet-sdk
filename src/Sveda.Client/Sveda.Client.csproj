<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Sveda.Client</RootNamespace>
    <AssemblyName>Sveda.Client</AssemblyName>
    <PackageId>sveda-dotnet-sdk</PackageId>
    <Version>0.1.0</Version>
    <Authors>Neresson</Authors>
    <Description>SDK for the Sveda AI sidecar HTTP API (embed tokens, streaming chat, histories).</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/neresson/sveda-dotnet-sdk</PackageProjectUrl>
    <RepositoryUrl>https://github.com/neresson/sveda-dotnet-sdk</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>sveda;ai;copilot;sdk</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
